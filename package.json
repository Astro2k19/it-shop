{
    "name": "@it-shop/source",
    "version": "0.0.0",
    "license": "MIT",
    "scripts": {
        "preinstall": "npx only-allow pnpm",
        "start:dev": "nx run-many --parallel --target=serve --projects=client,api-migration",
        "build:prod": "nx run-many --parallel --target=build --projects=client,api",
        "start:client": "nx serve client",
        "start:api": "nx serve api",
        "lint:api": "nx run api:lint",
        "lint:api:fix": "nx run api:lint --fix",
        "lint:client": "nx run client:lint",
        "lint:client:fix": "nx run client:lint --fix",
        "pretty-project": "prettier {**/*,*}.{js,ts,jsx,tsx} --write",
        "pull:db:dev": "dotenv -e ./apps/api-migration/.env.development -- prisma db pull",
        "prisma:push:dev": "dotenv -e ./apps/api-migration/.env.development -- prisma db push",
        "prisma:seed:dev": "dotenv -e ./apps/api-migration/.env.development -- prisma db seed",
        "migrate:dev": "npx prisma migrate dev",
        "migrate:dev:create": "npx prisma migrate dev --create-only",
        "migrate:deploy": "npx prisma migrate deploy",
        "prisma:generate": "npx prisma generate",
        "prisma:studio": "npx prisma studio",
        "prisma:seed": "npx prisma db seed",
        "nest:generate:module": "nx g module auth --project=api-migration"
    },
    "private": true,
