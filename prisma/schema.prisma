datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

type ProductImage {
  public_id String
  url       String
}

enum Role {
  Admin
  User
}

enum OrderStatus {
  Pending
  Shipped
  Delivered
  Cancelled
}

enum PaymentMethod {
  COD
  Card
}

model Order {
  ///@IsOptional
  id             String            @id @default(auto()) @map("_id") @db.ObjectId
  products       OrderProduct[]
  productsPrice  Float
  status         OrderStatus       @default(Pending)
  paymentInfo    OrderPaymentInfo  @relation(fields: [paymentInfoId], references: [id])
  paymentInfoId  String            @unique @db.ObjectId
  paymentMethod  PaymentMethod
  shippingAmount Float
  shippingInfo   OrderShippingInfo @relation(fields: [shippingInfoId], references: [id])
  shippingInfoId String            @unique @db.ObjectId
  taxAmount      Float
  totalAmount    Float
  user           User              @relation(fields: [userId], references: [id])
  userId         String            @db.ObjectId
  createdAt      DateTime          @default(now()) @db.Date
  updatedAt      DateTime          @updatedAt @db.Date
  deliveredAt    DateTime?         @db.Date
}

model OrderPaymentInfo {
  ///@IsOptional
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  status String
  order  Order?
}

model OrderShippingInfo {
  ///@IsOptional
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  order       Order?
  address     String
  city        String
  country     String
  phoneNumber String
  zipCode     String
}

model OrderProduct {
  ///@IsOptional
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  product   Product @relation(fields: [productId], references: [id])
  productId String  @db.ObjectId
  order     Order   @relation(fields: [orderId], references: [id])
  orderId   String  @db.ObjectId
  ///@Min(1)
  quantity  Int     @default(0)
}

model Product {
  ///@IsOptional
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  category      String
  description   String
  images        ProductImage[]
  ///@MaxLength(200)
  name          String
  ///@MaxLength(5)
  price         Float
  seller        String
  stock         Int
  user          User?          @relation(fields: [userId], references: [id])
  userId        String         @db.ObjectId
  reviews       Review[]
  orderProducts OrderProduct[] @ignore
  ratings       Float?         @default(0)
  ///IsOptional
  updatedAt     DateTime       @updatedAt @db.Date
  ///IsOptional
  createdAt     DateTime       @default(now()) @db.Date
}

model Review {
  ///@IsOptional
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  product   Product @relation(fields: [productId], references: [id])
  productId String  @db.ObjectId
  user      User    @relation(fields: [userId], references: [id])
  userId    String  @db.ObjectId
  comment   String
  ///@Max(5)
  ///@Min(1)
  rating    Float   @default(0)
}

model Token {
  ///IsOptional
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  refreshToken String
  user         User?  @relation(fields: [userId], references: [id])
  userId       String @unique @db.ObjectId
}

model User {
  ///IsOptional
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  email     String    @unique()
  ///@MaxLength(50)
  name      String
  ///@MinLength(8)
  password  String
  roles     Role[]    @default([User])
  token     Token?
  products  Product[]
  reviews   Review[]
  orders    Order[]
  ///IsOptional
  createdAt DateTime  @default(now()) @db.Date
  ///IsOptional
  updatedAt DateTime  @updatedAt @db.Date
}
