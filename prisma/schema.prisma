generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

type ProductImage {
  public_id String
  url       String
}

enum Role {
  Admin
  User
}

enum OrderStatus {
  Pending
  Shipped
  Delivered
  Cancelled
}

enum PaymentMethod {
  COD
  Card
}

model Order {
  id             String            @id @default(auto()) @map("_id") @db.ObjectId
  products       OrderProduct[]
  productsPrice  Float
  status         OrderStatus       @default(Pending)
  paymentInfo    OrderPaymentInfo  @relation(fields: [paymentInfoId], references: [id])
  paymentInfoId  String            @unique @db.ObjectId
  paymentMethod  PaymentMethod
  shippingAmount Float
  shippingInfo   OrderShippingInfo @relation(fields: [shippingInfoId], references: [id])
  shippingInfoId String            @unique @db.ObjectId
  taxAmount      Float
  totalAmount    Float
  user           User              @relation(fields: [userId], references: [id])
  userId         String            @db.ObjectId
  createdAt      DateTime          @default(now()) @db.Date
  updatedAt      DateTime          @updatedAt @db.Date
  deliveredAt    DateTime?         @db.Date
}

model OrderPaymentInfo {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  status String
  order  Order?
}

model OrderShippingInfo {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  order       Order?
  address     String
  city        String
  country     String
  phoneNumber String
  zipCode     String
}

model OrderProduct {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  product   Product @relation(fields: [productId], references: [id])
  productId String  @db.ObjectId
  order     Order   @relation(fields: [orderId], references: [id])
  orderId   String  @db.ObjectId
  quantity  Int     @default(0)
}

model Product {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  category      String
  description   String
  images        ProductImage[]
  name          String
  price         Float
  seller        String
  stock         Int
  user          User           @relation(fields: [userId], references: [id])
  userId        String         @db.ObjectId
  reviews       Review[]
  orderProducts OrderProduct[] @ignore
  updatedAt     DateTime       @updatedAt @db.Date
  createdAt     DateTime       @default(now()) @db.Date
}

model Review {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  product   Product @relation(fields: [productId], references: [id])
  productId String  @db.ObjectId
  user      User    @relation(fields: [userId], references: [id])
  userId    String  @db.ObjectId
  comment   String
  rating    Float
}

model Token {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  refreshToken String
  user         User   @relation(fields: [userId], references: [id])
  userId       String @unique @db.ObjectId
}

model User {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  email     String    @unique()
  name      String
  password  String
  roles     Role[]    @default([User])
  token     Token?
  products  Product[]
  reviews   Review[]
  orders    Order[]
  createdAt DateTime  @default(now()) @db.Date
  updatedAt DateTime  @updatedAt @db.Date
}
